[Unit]
Description=Gomoku ECS API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gomoku-ecs
Group=gomoku-ecs
WorkingDirectory=/opt/gomoku/current
Environment=NODE_ENV=production
Environment=GOMOKU_ECS_PORT=3088
Environment=GOMOKU_DB_PATH=/var/lib/gomoku/gomoku.sqlite
Environment=PRIVATE_GAME_MODE=1
EnvironmentFile=/etc/gomoku/gomoku.env
ExecStart=/opt/gomoku/runtime/node-v22.23.3/bin/node /opt/gomoku/current/backend/ecs-host/server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gomoku
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
